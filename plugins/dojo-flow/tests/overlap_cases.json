[
  {"name": "exact duplicate", "expect": "refuse", "tracks": [{"name": "a", "files": ["a.js"]}, {"name": "b", "files": ["a.js"]}]},
  {"name": "dot-slash against bare", "expect": "refuse", "tracks": [{"name": "a", "files": ["./a.js"]}, {"name": "b", "files": ["a.js"]}]},
  {"name": "directory with trailing slash against file inside", "expect": "refuse", "tracks": [{"name": "a", "files": ["src/"]}, {"name": "b", "files": ["src/x.js"]}]},
  {"name": "directory without trailing slash against file inside", "expect": "refuse", "tracks": [{"name": "a", "files": ["src"]}, {"name": "b", "files": ["src/x.js"]}]},
  {"name": "case difference", "expect": "refuse", "tracks": [{"name": "a", "files": ["A.js"]}, {"name": "b", "files": ["a.js"]}]},
  {"name": "doubled slash", "expect": "refuse", "tracks": [{"name": "a", "files": ["a//b.js"]}, {"name": "b", "files": ["a/b.js"]}]},
  {"name": "backslash separator", "expect": "refuse", "tracks": [{"name": "a", "files": ["src\\a.js"]}, {"name": "b", "files": ["src/a.js"]}]},
  {"name": "dot-dot segment is refused", "expect": "refuse", "tracks": [{"name": "a", "files": ["src/../a.js"]}, {"name": "b", "files": ["b.js"]}]},
  {"name": "absolute path outside the repo is refused", "expect": "refuse", "repo": "/work/repo", "tracks": [{"name": "a", "files": ["/etc/hosts"]}, {"name": "b", "files": ["b.js"]}]},
  {"name": "absolute path with no repo given is refused", "expect": "refuse", "tracks": [{"name": "a", "files": ["/work/repo/a.js"]}, {"name": "b", "files": ["b.js"]}]},
  {"name": "absolute path inside the repo overlaps its relative twin", "expect": "refuse", "repo": "/work/repo", "tracks": [{"name": "a", "files": ["/work/repo/src/a.js"]}, {"name": "b", "files": ["src/a.js"]}]},
  {"name": "repo root compared case-insensitively", "expect": "refuse", "repo": "/work/repo", "tracks": [{"name": "a", "files": ["/Work/Repo/a.js"]}, {"name": "b", "files": ["a.js"]}]},
  {"name": "glob is refused", "expect": "refuse", "tracks": [{"name": "a", "files": ["src/*.js"]}, {"name": "b", "files": ["b.js"]}]},
  {"name": "empty files list is refused", "expect": "refuse", "tracks": [{"name": "a", "files": []}, {"name": "b", "files": ["b.js"]}]},
  {"name": "duplicate track names are refused", "expect": "refuse", "tracks": [{"name": "a", "files": ["a.js"]}, {"name": "A", "files": ["b.js"]}]},
  {"name": "the track name contract is reserved", "expect": "refuse", "tracks": [{"name": "contract", "files": ["a.js"]}, {"name": "b", "files": ["b.js"]}]},
  {"name": "a track claiming the contract file overlaps", "expect": "refuse", "reserved": ".dojo/dag-contract.md", "tracks": [{"name": "a", "files": ["a.js"]}, {"name": "b", "files": [".dojo/dag-contract.md"]}]},
  {"name": "a track claiming the contract directory overlaps", "expect": "refuse", "reserved": ".dojo/dag-contract.md", "tracks": [{"name": "a", "files": ["a.js"]}, {"name": "b", "files": [".dojo/"]}]},
  {"name": "control: shared prefix that is not a directory prefix", "expect": "ok", "tracks": [{"name": "a", "files": ["src/a.js"]}, {"name": "b", "files": ["src/ab.js"]}]},
  {"name": "control: directory against a sibling with a longer name", "expect": "ok", "tracks": [{"name": "a", "files": ["src/"]}, {"name": "b", "files": ["srcx/a.js"]}]},
  {"name": "control: absolute inside the repo, different file", "expect": "ok", "repo": "/work/repo", "tracks": [{"name": "a", "files": ["/work/repo/src/a.js"]}, {"name": "b", "files": ["src/b.js"]}]},
  {"name": "control: contract reserved, nobody claims it", "expect": "ok", "reserved": ".dojo/dag-contract.md", "tracks": [{"name": "a", "files": ["a.js"]}, {"name": "b", "files": ["b.js"]}]},
  {"name": "control: the same file twice inside one track", "expect": "ok", "tracks": [{"name": "a", "files": ["a.js", "./a.js"]}, {"name": "b", "files": ["b.js"]}]},
  {"name": "control: one track alone", "expect": "ok", "tracks": [{"name": "solo", "files": ["a.js", "src/"]}]},
  {"name": "two tracks named __proto__ are duplicates", "expect": "refuse", "tracks": [{"name": "__proto__", "files": ["src/a.js"]}, {"name": "__proto__", "files": ["src/a.js"]}]},
  {"name": "two tracks named __proto__ with different files are still duplicates", "expect": "refuse", "tracks": [{"name": "__proto__", "files": ["a.js"]}, {"name": "__PROTO__", "files": ["b.js"]}]},
  {"name": "windows drive path outside the repo is refused", "expect": "refuse", "repo": "/work/repo", "tracks": [{"name": "a", "files": ["C:\\\\other\\\\x"]}, {"name": "b", "files": ["b.js"]}]},
  {"name": "windows drive path with forward slashes and no repo is refused", "expect": "refuse", "tracks": [{"name": "a", "files": ["d:/other/x.js"]}, {"name": "b", "files": ["b.js"]}]},
  {"name": "windows drive path inside a windows repo overlaps its relative twin", "expect": "refuse", "repo": "C:\\\\work\\\\repo", "tracks": [{"name": "a", "files": ["C:\\\\work\\\\repo\\\\src\\\\a.js"]}, {"name": "b", "files": ["src/a.js"]}]},
  {"name": "control: windows drive path inside a windows repo, different file", "expect": "ok", "repo": "C:\\\\work\\\\repo", "tracks": [{"name": "a", "files": ["C:\\\\work\\\\repo\\\\src\\\\a.js"]}, {"name": "b", "files": ["src/b.js"]}]},
  {"name": "control: one track named __proto__", "expect": "ok", "tracks": [{"name": "__proto__", "files": ["a.js"]}, {"name": "b", "files": ["b.js"]}]}
]
